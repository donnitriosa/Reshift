# Reshift runtime config. Copy to .env and edit. All values optional — defaults shown.
# docker-compose.yml loads .env via `env_file` (required: false).
# On Dokploy, set these in the Environment tab instead of committing .env.

# Max upload size for images, in MB.
MAX_FILE_MB=20

# Max upload size for PDFs, in MB.
MAX_PDF_MB=50

# Max number of files per /process/batch request.
MAX_BATCH_FILES=20

# Public site URL used in canonical, sitemap.xml and robots.txt.
SITE_URL=https://reshift.donnitriosa.my.id

# Set true on staging so Google does not index it. Adds X-Robots-Tag and noindex meta,
# drops Sitemap line from robots.txt. Keep false on production.
NOINDEX=false
